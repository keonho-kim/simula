{
  "name": "simula",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter @simula/server dev & bun --filter @simula/web dev",
    "dev:server": "bun --filter @simula/server dev",
    "dev:web": "bun --filter @simula/web dev",
    "test": "bun test",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "build": "bun --filter @simula/web build"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@langchain/anthropic": "^1.5.10",
    "@langchain/core": "^1.2.11",
