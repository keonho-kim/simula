{
  "name": "simula",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun scripts/ensure-dev-tls.ts && SIMULA_HTTPS=1 node --import tsx server.ts",
    "test": "bun test",
    "test:e2e": "bun scripts/ensure-dev-tls.ts && NEXT_PUBLIC_SIMULA_E2E=1 bun run build && playwright test",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "build": "bun run typecheck && node node_modules/next/dist/bin/next build --webpack",
    "start": "NODE_ENV=production node --import tsx server.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@langchain/anthropic": "^1.5.10",
    "@langchain/core": "^1.2.11",
    "@langchain/google-genai": "^2.3.2",
    "@langchain/langgraph": "^1.4.15",
    "@langchain/openai": "^1.5.13",
    "@napi-rs/canvas": "1.0.9",
    "@sigma/edge-curve": "^3.1.0",
    "@sqlite.org/sqlite-wasm": "3.53.4-build1",
    "@tailwindcss/postcss": "4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-virtual": "^3.14.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.3",
    "fast-xml-parser": "5.11.1",
    "fflate": "0.8.3",
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "graphology-types": "^0.24.8",
    "katex": "^0.16.47",
    "langchain": "^1.5.11",
    "lucide-react": "^1.46.0",
    "motion": "13.3.0",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "papaparse": "5.7.0",
    "pdfjs-dist": "6.3.289",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shadcn": "^4.21.0",
    "sigma": "^3.0.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.15",
    "ws": "8.21.3",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.5.1",
    "@types/papaparse": "5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "8.18.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
